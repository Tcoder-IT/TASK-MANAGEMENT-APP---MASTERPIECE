# StudyFlow Client Environment Variables
# Copy this file to .env and fill in your values
# DO NOT COMMIT .env FILES TO VERSION CONTROL

# ============================================
# API Configuration
# ============================================
# API base URL (used by axios client)
# In development, this is typically handled by Vite proxy
# In production, set to your API domain (e.g., https://api.studyflow.example.com)
VITE_API_URL=/api/v1