# StudyFlow Environment Variables
# Copy this file to .env and fill in your values
# DO NOT COMMIT .env FILES TO VERSION CONTROL

# ============================================
# Application
# ============================================
NODE_ENV=development
PORT=5000
API_VERSION=v1

# ============================================
# Database
# ============================================
MONGODB_URI=mongodb://localhost:27017/studyflow

# ============================================
# Authentication (JWT)
# ============================================
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=your-super-secret-access-key-at-least-32-chars-long
JWT_REFRESH_SECRET=your-super-secret-refresh-key-at-least-32-chars-long
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ============================================
# Cookies
# ============================================
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# ============================================
# CORS
# ============================================
CORS_ORIGIN=http://localhost:5173

# ============================================
# Rate Limiting
# ============================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_AUTH_MAX_REQUESTS=10

# ============================================
# Body Parser
# ============================================
BODY_LIMIT=10kb

# ============================================
# Web Push Notifications (VAPID)
# ============================================
# Generate with: npx web-push generate-vapid-keys
# Optional - push notifications will be disabled if not provided
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:your-email@example.com

# ============================================
# Email (SMTP via Nodemailer)
# ============================================
# Optional - password reset emails will log to console if not configured
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=your-smtp-username
EMAIL_PASS=your-smtp-password
EMAIL_FROM=StudyFlow <noreply@studyflow.example.com>